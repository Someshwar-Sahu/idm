#include <windows.h>

// Application Icon (First icon in .rc becomes default explorer icon for the executable)
101 ICON "idm.ico"
IDI_APPICON ICON "idm.ico"

// Version Information matching IDM 6.38
1 VERSIONINFO
FILEVERSION     6,38,25,0
PRODUCTVERSION  6,38,25,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tonec Inc. / IDM Open Engine"
            VALUE "FileDescription",  "Internet Download Manager (IDM)"
            VALUE "FileVersion",      "6.38.25"
            VALUE "InternalName",     "IDMan"
            VALUE "LegalCopyright",   "Copyright (C) 1999-2026 Tonec Inc."
            VALUE "OriginalFilename", "IDMan.exe"
            VALUE "ProductName",      "Internet Download Manager"
            VALUE "ProductVersion",   "6.38.25"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Embedded Zero-Browser UI Resources
1001 RCDATA "../../ui/index.html"
1002 RCDATA "../../ui/css/styles.css"
1003 RCDATA "../../ui/js/app.js"
1004 RCDATA "../../ui/js/chunk_visualizer.js"
